# Postgres connection string. Any Postgres works; Neon's free plan is what the demo uses.
# Neon: Dashboard → your project → Connect → copy the "postgresql://..." string.
DATABASE_URL=

# Optional. Set it on a public deployment to reset the demo data every night at 04:00 UTC
# (Vercel Cron calls /api/reset with this as a Bearer token). Leave empty to keep data forever.
CRON_SECRET=
